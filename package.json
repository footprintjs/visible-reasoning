    "example:7": "node 07-chat-desk/run.js",
    "chat-desk": "node 07-chat-desk/run.js --serve",
    "chat-desk:live": "node --env-file=.env 07-chat-desk/run.js --serve --live",
    "example:8": "node 08-app-gallery/run.js",
